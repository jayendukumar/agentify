      "credentials": [
        {
          "type": "password",
          "value": "Axyntro!2026",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "Authenticator app (seeded)",
          "secretData": "{\"value\": \"axyntro-dev-otp-nils\"}",
          "credentialData": "{\"subType\": \"totp\", \"digits\": 6, \"counter\": 0, \"period\": 30, \"algorithm\": \"HmacSHA1\"}"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "axyntro",
      "name": "Axyntro",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "northwind-dev-only-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://northwind.localhost:8000/api/auth/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://northwind.localhost:3000/*",
        "backchannel.logout.url": "http://api:8000/api/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "acr.loa.map": "{\"pwd\": 1, \"mfa\": 2}"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "SSO cookie, or the forms below",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-mfa forms",
          "requirement": "ALTERNATIVE",
          "priority": 20
        }
      ]
    },
    {
      "alias": "browser-mfa forms",
      "description": "Level 1: password. Level 2 (acr mfa): one-time code",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-mfa level 1",
          "requirement": "CONDITIONAL",
          "priority": 10
        },
        {
          "authenticatorFlow": true,
          "autheticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "browser-mfa level 2",
          "requirement": "CONDITIONAL",
          "priority": 20
        }
      ]
    },
    {
      "alias": "browser-mfa level 1",
      "description": "Password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "level-1",
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    },
    {
      "alias": "browser-mfa level 2",
      "description": "One-time code",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "level-2",
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticatorFlow": false,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "level-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "level-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
