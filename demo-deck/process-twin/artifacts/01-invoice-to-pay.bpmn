<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_invoice_to_pay" targetNamespace="http://agentic-solution-generator/bpmn"><bpmn:process id="Process_invoice_to_pay" isExecutable="false"><bpmn:laneSet id="LaneSet_invoice_to_pay"><bpmn:lane id="Lane_ap" name="Accounts Payable Team"><bpmn:flowNodeRef>Event_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t3</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_e1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t4</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t6</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_g3</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t7</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t8</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_g4</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t10</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t12</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_e3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ctrl" name="Finance Controller"><bpmn:flowNodeRef>Task_t5</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_e2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_bh" name="Budget Holder"><bpmn:flowNodeRef>Task_t9</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_treas" name="Treasury"><bpmn:flowNodeRef>Task_t11</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Event_s1" name="Supplier invoice received"><bpmn:outgoing>Flow_f1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_t1" name="Capture invoice data from the received document"><bpmn:incoming>Flow_f1</bpmn:incoming><bpmn:outgoing>Flow_f2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_t2" name="Verify supplier against the vendor master and sanctions list"><bpmn:incoming>Flow_f2</bpmn:incoming><bpmn:outgoing>Flow_f3</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_g1" name="Supplier verified?"><bpmn:incoming>Flow_f3</bpmn:incoming><bpmn:outgoing>Flow_f4</bpmn:outgoing><bpmn:outgoing>Flow_f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_t3" name="Reject invoice and notify the supplier"><bpmn:incoming>Flow_f5</bpmn:incoming><bpmn:outgoing>Flow_f6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Event_e1" name="Invoice rejected"><bpmn:incoming>Flow_f6</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_t4" name="Check for duplicate invoices and payment fraud signals"><bpmn:incoming>Flow_f4</bpmn:incoming><bpmn:outgoing>Flow_f7</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_g2" name="Duplicate or fraud suspected?"><bpmn:incoming>Flow_f7</bpmn:incoming><bpmn:outgoing>Flow_f8</bpmn:outgoing><bpmn:outgoing>Flow_f9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_t5" name="Investigate suspected duplicate or fraud"><bpmn:incoming>Flow_f8</bpmn:incoming><bpmn:outgoing>Flow_f10</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Event_e2" name="Invoice blocked"><bpmn:incoming>Flow_f10</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_t6" name="Match invoice to purchase order and goods receipt"><bpmn:incoming>Flow_f9</bpmn:incoming><bpmn:outgoing>Flow_f11</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_g3" name="Matched within tolerance?"><bpmn:incoming>Flow_f11</bpmn:incoming><bpmn:outgoing>Flow_f12</bpmn:outgoing><bpmn:outgoing>Flow_f13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_t7" name="Resolve the match exception with buyer and supplier"><bpmn:incoming>Flow_f13</bpmn:incoming><bpmn:outgoing>Flow_f14</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_t8" name="Code invoice to GL accounts and validate VAT"><bpmn:incoming>Flow_f12</bpmn:incoming><bpmn:incoming>Flow_f14</bpmn:incoming><bpmn:outgoing>Flow_f15</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_g4" name="Invoice above EUR 10,000?"><bpmn:incoming>Flow_f15</bpmn:incoming><bpmn:outgoing>Flow_f16</bpmn:outgoing><bpmn:outgoing>Flow_f17</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_t9" name="Approve invoice spend"><bpmn:incoming>Flow_f16</bpmn:incoming><bpmn:outgoing>Flow_f18</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_t10" name="Post invoice to the ERP ledger"><bpmn:incoming>Flow_f17</bpmn:incoming><bpmn:incoming>Flow_f18</bpmn:incoming><bpmn:outgoing>Flow_f19</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_t11" name="Schedule payment in the next payment run"><bpmn:incoming>Flow_f19</bpmn:incoming><bpmn:outgoing>Flow_f20</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_t12" name="Send remittance advice to the supplier"><bpmn:incoming>Flow_f20</bpmn:incoming><bpmn:outgoing>Flow_f21</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Event_e3" name="Invoice paid"><bpmn:incoming>Flow_f21</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_f1" sourceRef="Event_s1" targetRef="Task_t1" /><bpmn:sequenceFlow id="Flow_f2" sourceRef="Task_t1" targetRef="Task_t2" /><bpmn:sequenceFlow id="Flow_f3" sourceRef="Task_t2" targetRef="Gateway_g1" /><bpmn:sequenceFlow id="Flow_f4" sourceRef="Gateway_g1" targetRef="Task_t4"><bpmn:conditionExpression>Yes</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f5" sourceRef="Gateway_g1" targetRef="Task_t3"><bpmn:conditionExpression>No</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f6" sourceRef="Task_t3" targetRef="Event_e1" /><bpmn:sequenceFlow id="Flow_f7" sourceRef="Task_t4" targetRef="Gateway_g2" /><bpmn:sequenceFlow id="Flow_f8" sourceRef="Gateway_g2" targetRef="Task_t5"><bpmn:conditionExpression>Yes</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f9" sourceRef="Gateway_g2" targetRef="Task_t6"><bpmn:conditionExpression>No</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFl