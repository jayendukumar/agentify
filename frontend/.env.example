# Optional -- leave unset for local dev. src/api/client.ts defaults to
# matching whatever hostname the browser used to load the frontend itself
# (e.g. http://localhost:8000 if you opened http://localhost:3000, or
# http://127.0.0.1:8000 if you opened http://127.0.0.1:3000), which keeps
# the session cookie's SameSite=Lax check happy. Only set this if the API
# is reachable at a genuinely different host than the frontend.
# VITE_API_BASE_URL=http://127.0.0.1:8000
