# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Env files at the root, if any ever appear (backend/ and frontend/ have
# their own .gitignore covering their respective .env files already)
.env
.env.local

# Local browser review screenshots and reports
frontend/.ui-review/

# Demo deck screenshot capture: frontend build and raw replay frames
demo-deck/build/capture/demo-dist/
demo-deck/build/capture/frames/

# Python bytecode (backend/ has its own rule; this covers tools/ and demo-deck/)
__pycache__/
*.pyc

# Office lock files left while a deck is open
~$*

# Static wiki build (python -m tools.docs build)
docs/site/
