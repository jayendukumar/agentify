# OpenRouter (see planning/claude-api-access-notes.md for why OpenRouter/Qwen3.7 Flash
# was chosen, and .claude/skills/local-stack-bootstrap/SKILL.md for the integration shape)
OPENROUTER_API_KEY=sk-or-v1-replace-me
LLM_MODEL=qwen/qwen3.7-flash
LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: OpenRouter attribution headers (shows up on openrouter.ai/rankings) -- safe to leave unset
LLM_SITE_URL=
LLM_APP_NAME=Agentic Solution Generator

LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Usage instrumentation (Epic 10, US10.3) -- every LLM call is recorded here
# as a JSON line (operation, model, tokens, estimated cost). Inspect with
# scripts/usage_report.py.
LLM_USAGE_LOG_ENABLED=true
LLM_USAGE_LOG_PATH=.data/llm_usage.jsonl

# Postgres (Epic 2) -- matches docker-compose.yml's `db` service. pgvector
# lives on this same instance (see planning/document-ingestion-strategy.md).
DATABASE_URL=postgresql+psycopg://agentic:agentic@127.0.0.1:5432/agentic_solution_generator

# Local embedding model for document chunk embeddings (Epic 2, US2.3) --
# not an API call, downloaded once and cached.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Where uploaded documents are stored (Epic 1/2, US2.4 simplification --
# local disk, not an object store; see local-stack-bootstrap skill)
DOCUMENT_STORAGE_PATH=.data/uploads
