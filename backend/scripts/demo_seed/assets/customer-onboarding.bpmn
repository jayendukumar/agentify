<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_demo" targetNamespace="http://agentic-solution-generator/bpmn"><bpmn:process id="Process_demo" isExecutable="false"><bpmn:laneSet id="LaneSet_demo"><bpmn:lane id="Lane_a_ops" name="Onboarding Officer"><bpmn:flowNodeRef>Event_s1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_e1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t3</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_t7</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_e3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_a_credit" name="Credit Analyst"><bpmn:flowNodeRef>Task_t5</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_g3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_a_mlro" name="MLRO"><bpmn:flowNodeRef>Task_t4</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_e2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_a_cro" name="Chief Risk Officer"><bpmn:flowNodeRef>Task_t6</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Event_s1" name="Customer application received"><bpmn:outgoing>Flow_f1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_t1" name="Verify customer identity"><bpmn:incoming>Flow_f1</bpmn:incoming><bpmn:outgoing>Flow_f2</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_g1" name="Identity verified?"><bpmn:incoming>Flow_f2</bpmn:incoming><bpmn:outgoing>Flow_f3</bpmn:outgoing><bpmn:outgoing>Flow_f4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_t2" name="Reject application and notify customer"><bpmn:incoming>Flow_f4</bpmn:incoming><bpmn:outgoing>Flow_f5</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Event_e1" name="Application rejected"><bpmn:incoming>Flow_f5</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_t3" name="Screen customer against EU sanctions list"><bpmn:incoming>Flow_f3</bpmn:incoming><bpmn:outgoing>Flow_f6</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_g2" name="Potential sanctions match?"><bpmn:incoming>Flow_f6</bpmn:incoming><bpmn:outgoing>Flow_f7</bpmn:outgoing><bpmn:outgoing>Flow_f8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_t4" name="MLRO reviews potential sanctions match"><bpmn:incoming>Flow_f7</bpmn:incoming><bpmn:outgoing>Flow_f9</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Event_e2" name="Referred to compliance"><bpmn:incoming>Flow_f9</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_t5" name="Assess and set initial credit limit"><bpmn:incoming>Flow_f8</bpmn:incoming><bpmn:outgoing>Flow_f10</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_g3" name="Requested limit above EUR 50,000?"><bpmn:incoming>Flow_f10</bpmn:incoming><bpmn:outgoing>Flow_f11</bpmn:outgoing><bpmn:outgoing>Flow_f12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_t6" name="Chief Risk Officer approves credit limit"><bpmn:incoming>Flow_f11</bpmn:incoming><bpmn:outgoing>Flow_f13</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_t7" name="Activate customer account"><bpmn:incoming>Flow_f12</bpmn:incoming><bpmn:incoming>Flow_f13</bpmn:incoming><bpmn:outgoing>Flow_f14</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Event_e3" name="Customer onboarded"><bpmn:incoming>Flow_f14</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_f1" sourceRef="Event_s1" targetRef="Task_t1" /><bpmn:sequenceFlow id="Flow_f2" sourceRef="Task_t1" targetRef="Gateway_g1" /><bpmn:sequenceFlow id="Flow_f3" sourceRef="Gateway_g1" targetRef="Task_t3"><bpmn:conditionExpression>Yes - identity verified</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f4" sourceRef="Gateway_g1" targetRef="Task_t2"><bpmn:conditionExpression>No - verification failed</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f5" sourceRef="Task_t2" targetRef="Event_e1" /><bpmn:sequenceFlow id="Flow_f6" sourceRef="Task_t3" targetRef="Gateway_g2" /><bpmn:sequenceFlow id="Flow_f7" sourceRef="Gateway_g2" targetRef="Task_t4"><bpmn:conditionExpression>Yes - potential match</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f8" sourceRef="Gateway_g2" targetRef="Task_t5"><bpmn:conditionExpression>No - clear</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f9" sourceRef="Task_t4" targetRef="Event_e2" /><bpmn:sequenceFlow id="Flow_f10" sourceRef="Task_t5" targetRef="Gateway_g3" /><bpmn:sequenceFlow id="Flow_f11" sourceRef="Gateway_g3" targetRef="Task_t6"><bpmn:conditionExpression>Above EUR 50,000</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f12" sourceRef="Gateway_g3" targetRef="Task_t7"><bpmn:conditionExpression>EUR 50,000 or less</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_f13" sourceRef="Task_t6" targetRef="Task_t7" /><bpmn:sequenceFlow id="Flow_f14" sourceRef="Task_t7" targetRef="Event_e3" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_demo"><bpmndi:BPMNPlane id="Plane_demo" bpmnElement="Process_demo"><bpmndi:BPMNShape id="Shape_Lane_a_ops" bpmnElement="Lane_a_ops" isHorizontal="true"><dc:Bounds x="70" y="80" width="1716" height="260" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_a_credit" bpmnElement="Lane_a_credit" isHorizontal="true"><dc:Bounds x="70" y="380" width="1716" height="140" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_a_mlro" bpmnElement="Lane_a_mlro" isHorizontal="true"><dc:Bounds x="70" y="560" width="1716" height="140" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Lane_a_cro" bpmnElement="Lane_a_cro" isHorizontal="true"><dc:Bounds x="70" y="740" width="1716" height="140" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Event_s1" bpmnElement="Event_s1"><dc:Bounds x="100